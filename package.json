{
  "name": "mercadolibre-sellers-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP propio para conectar Claude con cuentas de vendedores de Mercado Libre. Solo lectura por defecto, tokens cifrados solo en tu computadora, sin servidores intermediarios.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mercadolibre-sellers-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "skills/",
    "panel/",
    "plantillas/",
    "docs/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 test/unidad.test.js test/sesiones.test.js test/herramientas.test.js test/servidor.test.js",
    "auditoria": "npm audit --omit=dev && node scripts/buscar-secretos.js",
    "secretos": "node scripts/buscar-secretos.js",
    "plantilla": "node plantillas/generar.js"
  },
  "keywords": [
    "mercadolibre",
    "mcp",
    "claude",
    "model-context-protocol",
    "vendedores"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  }
}
