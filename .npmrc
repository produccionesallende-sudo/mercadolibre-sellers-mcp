# Endurecimiento de la cadena de suministro (supply chain)
# - Nunca ejecutar scripts de instalación (preinstall/install/postinstall) de dependencias.
# - Guardar versiones exactas (sin ^ ni ~).
# - Sin mensajes de financiamiento ni chequeo de actualizaciones de npm.
ignore-scripts=true
save-exact=true
fund=false
update-notifier=false
engine-strict=true
audit-level=moderate
