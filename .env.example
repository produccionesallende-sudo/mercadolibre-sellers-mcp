# ──────────────────────────────────────────────────────────────────────────────
# mercadolibre-sellers-mcp — variables de entorno (EJEMPLO)
#
# Este archivo es SOLO una plantilla. NO pongas aquí tus valores reales y NUNCA
# subas un archivo .env a GitHub (.gitignore ya lo bloquea).
# Lo normal es poner estas variables en la configuración de Claude Desktop
# (bloque "env") o con `claude mcp add -e ...` en Claude Code. Ver README.
# ──────────────────────────────────────────────────────────────────────────────

# Credenciales de TU aplicación de Mercado Libre (DevCenter → Mis aplicaciones).
# El "Client ID" también aparece como "App ID". El "Client Secret" es una
# contraseña: no lo compartas.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Redirect URI EXACTA configurada en tu aplicación de Mercado Libre.
# Debe coincidir carácter por carácter con la registrada en el DevCenter.
# Ver README → "Redirect URI" para las opciones recomendadas.
ML_REDIRECT_URI=

# País por defecto para el enlace de autorización (MLA Argentina, MLM México,
# MLB Brasil, MLC Chile, MCO Colombia, MLU Uruguay, MPE Perú, etc.).
ML_SITE=MLA

# SEGURIDAD — SOLO LECTURA ACTIVADO POR DEFECTO.
# Mientras sea "true" (o no esté definida) NINGUNA herramienta puede modificar
# tu cuenta de Mercado Libre. Para habilitar escrituras hay que poner
# exactamente: SOLO_LECTURA=false
SOLO_LECTURA=true

# Opcional: con SOLO_LECTURA=false, limita QUÉ escrituras se permiten
# (lista separada por comas). Si se deja vacía, se permiten todas.
# Valores: ml_actualizar_publicacion, ml_crear_publicacion, ml_responder_pregunta,
#          ml_aceptar_promocion, ml_subir_clip, ml_borrar_clip
ESCRITURAS_PERMITIDAS=

# Opcional: carpeta donde se guardan los tokens cifrados, la vigilancia y el
# registro de auditoría. Por defecto: ~/.mercadolibre-sellers-mcp
ML_CONFIG_DIR=

# Opcional: carpeta ÚNICA desde la que ml_subir_clip puede leer videos.
# Por defecto: <ML_CONFIG_DIR>/clips
ML_DIRECTORIO_CLIPS=

# Opcional: secreto adicional para cifrar el almacén de tokens (además del
# Client Secret). Si lo usás, guardalo bien: sin él no se pueden leer los tokens.
ML_CLAVE_ALMACEN=

# Opcional: nivel de log en stderr (error | warn | info | debug). Default: info
ML_LOG_NIVEL=info
